import React from 'react';
import AgentActivityAccordion from '../../components/AgentActivityAccordion';

export default function AnalyticsTab({
  analytics,
  token,
  logout,
  apiUrl
}) {
  return (
    <div className="max-w-7xl mx-auto">
      <div className="mb-12">
        <h1 className="text-4xl font-display font-extrabold text-slate-900 mb-2">Analytics</h1>
        <p className="text-slate-500 font-medium text-lg">System throughput, Swarm delegation matrix, and credit velocity.</p>
      </div>

      {!analytics ? (
        <div className="text-center text-slate-400 flex flex-col items-center py-32 bg-white/50 backdrop-blur-sm rounded-[3rem] border border-white shadow-[0_20px_40px_-15px_rgba(0,0,0,0.02)]">
          <div className="w-12 h-12 border-4 border-slate-200 border-t-emerald-500 rounded-full animate-spin mb-6"/>
          <p className="font-bold tracking-wide text-lg text-slate-600">Gathering System Metrics…</p>
        </div>
      ) : (
        <div className="space-y-8">
          {/* Stat cards */}
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-6">
            {[
              { label: 'Total Swarm Tasks', value: analytics.total_tasks, sub: 'operational logs', color: 'text-emerald-600 bg-emerald-500/5 border-emerald-100/50' },
              { label: 'Autonomous Agents', value: analytics.active_agents, sub: 'active in pipeline', color: 'text-indigo-600 bg-indigo-500/5 border-indigo-100/50' },
              { label: 'A2A Delegations', value: analytics.delegation_count, sub: 'swarm-orchestrated', color: 'text-purple-600 bg-purple-500/5 border-purple-100/50' },
              { label: 'Credits Velocity', value: analytics.credit_balance, sub: `${analytics.credits_spent_on_hires} cr spent on hires`, color: 'text-amber-600 bg-amber-500/5 border-amber-100/50' },
            ].map(({ label, value, sub, color }) => (
              <div key={label} className={`bg-white/80 backdrop-blur-xl rounded-[2rem] p-6 border shadow-[0_15px_30px_-10px_rgba(0,0,0,0.03)] transition-all hover:-translate-y-0.5 duration-350 ${color.split(' ').slice(1).join(' ')}`}>
                <div className={`text-4.5xl font-display font-extrabold mb-1.5 ${color.split(' ')[0]}`}>{value}</div>
                <div className="text-xs font-bold text-slate-700 uppercase tracking-widest">{label}</div>
                <div className="text-[10px] text-slate-400 font-bold uppercase mt-1 tracking-wider">{sub}</div>
              </div>
            ))}
          </div>

          {/* Weekly activity bar chart */}
          <div className="bg-white/80 backdrop-blur-xl rounded-[2.5rem] p-8 border border-white shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <h3 className="text-lg font-display font-bold text-slate-900 mb-1">Weekly Swarm Activity</h3>
            <p className="text-sm text-slate-400 font-medium mb-8">Swarm cycles executed per week over the last 8 weeks.</p>
            {(() => {
              const max = Math.max(...analytics.tasks_per_week.map(w => w.count), 1);
              return (
                <div className="flex items-end gap-3" style={{ height: '140px' }}>
                  {analytics.tasks_per_week.map((week, i) => (
                    <div key={i} className="flex-1 flex flex-col items-center justify-end gap-2 h-full">
                      <span className="text-[10px] font-bold text-slate-650">{week.count > 0 ? week.count : ''}</span>
                      <div
                        className={`w-full rounded-t-xl transition-all duration-500 ${i === analytics.tasks_per_week.length - 1 ? 'bg-emerald-500 shadow-[0_4px_12px_rgba(16,185,129,0.3)]' : 'bg-slate-200/70 hover:bg-slate-300'}`}
                        style={{ height: `${Math.max((week.count / max) * 100, week.count > 0 ? 4 : 1)}%` }}
                      />
                      <span className="text-[10px] text-slate-400 font-bold uppercase tracking-wider">{week.label}</span>
                    </div>
                  ))}
                </div>
              );
            })()}
          </div>

          {/* Tasks per agent horizontal bars */}
          <div className="bg-white/80 backdrop-blur-xl rounded-[2.5rem] p-8 border border-white shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <h3 className="text-lg font-display font-bold text-slate-900 mb-1">Tasks per Agent</h3>
            <p className="text-sm text-slate-400 font-medium mb-6">Execution cycles dispatched per autonomous unit.</p>
            {analytics.tasks_per_agent.length === 0 ? (
              <p className="text-slate-400 text-sm">No tasks completed yet.</p>
            ) : (() => {
              const max = Math.max(...analytics.tasks_per_agent.map(a => a.count), 1);
              return (
                <div className="space-y-5">
                  {analytics.tasks_per_agent.map(agent => (
                    <div key={agent.agent_id} className="flex items-center gap-4">
                      <div className="w-36 shrink-0">
                        <p className="text-sm font-bold text-slate-700 truncate">{agent.agent_name}</p>
                      </div>
                      <div className="flex-1 bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200/10">
                        <div
                          className="h-full bg-gradient-to-r from-emerald-500 to-indigo-500 rounded-full transition-all duration-700"
                          style={{ width: `${(agent.count / max) * 100}%` }}
                        />
                      </div>
                      <span className="text-xs font-extrabold text-slate-900 w-8 text-right shrink-0">{agent.count}</span>
                    </div>
                  ))}
                </div>
              );
            })()}
          </div>

          {/* Agent activity log */}
          <div className="bg-white/80 backdrop-blur-xl rounded-[2.5rem] p-8 border border-white shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <h3 className="text-lg font-display font-bold text-slate-900 mb-1">Per-Agent Activity Log</h3>
            <p className="text-sm text-slate-400 font-medium mb-6">Expand any active agent to review their raw execution transaction ledger.</p>
            {analytics.tasks_per_agent.length === 0 ? (
              <p className="text-slate-400 text-sm">No agent activity yet.</p>
            ) : (
              <AgentActivityAccordion agents={analytics.tasks_per_agent} token={token} logout={logout} apiUrl={apiUrl} />
            )}
          </div>
        </div>
      )}
    </div>
  );
}
