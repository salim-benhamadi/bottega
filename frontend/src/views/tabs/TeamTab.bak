import React from 'react';

export default function TeamTab({
  team,
  setActiveTab,
  taskInputs,
  setTaskInputs,
  taskResults,
  loadingTasks,
  handleFire,
  handleTaskAssign,
  handleApproveTask,
  handleEndProbation,
  fetchPerformance
}) {
  return (
    <div className="max-w-7xl mx-auto">
      <div className="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div><h1 className="text-4xl font-display font-extrabold text-slate-900 mb-2">Your Team</h1><p className="text-slate-500 font-medium text-lg">Manage your deployed agents and assign operational objectives.</p></div>
        {team.length > 0 && (
          <button onClick={()=>setActiveTab('marketplace')} className="bg-emerald-500 text-white px-6 py-3.5 rounded-2xl font-bold shadow-[0_8px_16px_-6px_rgba(16,185,129,0.4)] hover:shadow-[0_12px_20px_-6px_rgba(16,185,129,0.5)] hover:-translate-y-0.5 active:translate-y-0 transition-all text-sm flex items-center gap-2">Hire Agent <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v16m8-8H4"></path></svg></button>
        )}
      </div>
      
      <div className="grid grid-cols-1 xl:grid-cols-2 gap-8">
        {team.length===0&&(
          <div className="col-span-full py-24 text-center border-2 border-dashed border-slate-200/50 rounded-[3rem] bg-white/50 backdrop-blur-sm">
            <p className="text-slate-400 text-lg font-medium mb-6">Your team is empty. Hire specialized agents to get started.</p>
            <button onClick={()=>setActiveTab('marketplace')} className="bg-slate-900 text-white px-8 py-4 rounded-2xl font-bold hover:bg-emerald-500 transition-all shadow-lg flex items-center gap-2 mx-auto">Go to Marketplace <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg></button>
          </div>
        )}
        {team.map(agent => {
          const result = taskResults[agent.id];
          const isMeeting = agent.role === 'Meeting Analyst';
          return (
            <div key={agent.id} className="bg-white/80 backdrop-blur-xl p-8 rounded-[2.5rem] shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] border border-white flex flex-col relative overflow-hidden group hover:-translate-y-0.5 transition-all duration-300">
              {loadingTasks[agent.id]&&<div className="absolute top-0 left-0 w-full h-1 bg-emerald-500 animate-pulse"/>}
              
              {/* Decorative background glow */}
              <div className="absolute top-0 right-0 w-40 h-40 bg-emerald-400/5 rounded-full blur-[40px] pointer-events-none"></div>

              <div className="flex justify-between items-start mb-6 relative z-10">
                <div className="flex items-center gap-4">
                  <div className="w-16 h-16 rounded-[1.25rem] bg-gradient-to-br from-emerald-50 to-emerald-100/50 border border-emerald-100 flex items-center justify-center text-emerald-600 font-display font-extrabold text-2xl group-hover:scale-110 transition-all duration-500">{agent.name.charAt(0)}</div>
                  <div>
                    <h3 className="text-2xl font-display font-bold text-slate-900 tracking-tight">{agent.name}</h3>
                    <p className="text-sm text-slate-500 font-medium">{agent.role}</p>
                  </div>
                </div>
                <div className="flex flex-col items-end gap-2">
                  {agent.probation_mode ? (
                    <div className="flex items-center gap-2">
                      <span className="bg-amber-100/60 text-amber-700 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-lg border border-amber-200/50">Probation</span>
                      <button onClick={()=>handleEndProbation(agent.id)} className="text-[10px] text-slate-400 hover:text-slate-600 font-bold uppercase tracking-wider transition-colors">End</button>
                    </div>
                  ) : (
                    <span className="bg-emerald-100/40 text-emerald-700 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-lg border border-emerald-200/30">Fully Autonomous</span>
                  )}
                  <div className="flex items-center gap-3 mt-1">
                    {isMeeting&&<span className="text-[9px] bg-indigo-100/50 text-indigo-700 px-2 py-0.5 rounded border border-indigo-200/50 font-bold uppercase tracking-widest">Speechmatics</span>}
                    <button onClick={()=>handleFire(agent.id, agent.name)} className="text-xs text-rose-400 hover:text-rose-600 font-bold transition-colors">Fire</button>
                  </div>
                </div>
              </div>

              {result?.pending_approval&&(
                <div className="mb-5 p-5 bg-amber-50/50 border border-amber-200/50 rounded-2xl flex items-center justify-between gap-4 animate-pulse relative z-10">
                  <div><p className="text-amber-700 text-xs font-bold uppercase tracking-widest mb-1 flex items-center gap-1.5"><span className="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Pending Approval</p><p className="text-amber-600 text-xs font-semibold">Verify facts before they commit to Dossier memory.</p></div>
                  <button onClick={()=>handleApproveTask(agent.id)} className="shrink-0 bg-slate-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold hover:bg-emerald-500 transition-all shadow-md">Approve</button>
                </div>
              )}

              <div className="bg-slate-50/50 rounded-2xl p-4 border border-slate-100 focus-within:bg-white focus-within:ring-4 focus-within:ring-emerald-500/10 focus-within:border-emerald-500/50 transition-all mb-5 relative z-10">
                <textarea className="w-full bg-transparent resize-none outline-none text-sm text-slate-700 placeholder-slate-400 font-medium" rows="2" placeholder={`Deploy objective to ${agent.name}...`} value={taskInputs[agent.id]||''} onChange={e=>setTaskInputs(prev=>({...prev,[agent.id]:e.target.value}))} />
                <div className="flex justify-end mt-2">
                  <button onClick={()=>handleTaskAssign(agent.id)} disabled={loadingTasks[agent.id]||!taskInputs[agent.id]} className="bg-slate-900 text-white hover:bg-emerald-500 text-xs px-5 py-2.5 rounded-xl font-bold transition-all disabled:opacity-30 flex items-center gap-1">
                    {loadingTasks[agent.id] ? (
                      <><div className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>Thinking...</>
                    ) : (
                      <><svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>Deploy</>
                    )}
                  </button>
                </div>
              </div>

              {result?.result&&(
                <div className="mb-5 p-5 bg-emerald-50/40 border border-emerald-100/50 rounded-2xl text-sm text-slate-700 max-h-60 overflow-y-auto relative z-10">
                  <p className="text-emerald-700 mb-2 font-bold flex items-center gap-1.5 text-xs uppercase tracking-widest"><span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"/>Execution Output</p>
                  <p className="whitespace-pre-wrap font-medium text-slate-600 leading-relaxed text-xs">{result.result}</p>
                  {result.delegated&&<p className="mt-3 text-xs text-indigo-600 font-bold border-t border-emerald-100/50 pt-2 flex items-center gap-1.5"><svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>Autonomous delegation &rarr; {result.delegated_to}</p>}
                </div>
              )}

              <button onClick={()=>fetchPerformance(agent.id)} className="w-full text-xs font-bold bg-white/50 border border-slate-200 text-slate-600 py-3.5 rounded-xl hover:border-emerald-500 hover:text-emerald-600 transition-all mt-auto flex items-center justify-center gap-1.5">View Dossier & Performance Review <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5l7 7-7 7"></path></svg></button>
            </div>
          );
        })}
      </div>
    </div>
  );
}
